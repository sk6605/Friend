# ─────────────────────────────────────────────────────────────────────────────
# Friend AI — 环境变量清单（只写变量名，绝不写真实值）
#
# 部署拓扑：GitHub → Amplify（前端） + EC2（后端） + RDS（MySQL） + S3（存放后端 .env）
#
#   A. 后端变量 → 写进一个文件，上传到 S3（私有 bucket），EC2 每次部署时拉取为 .env
#   B. 前端变量 → 只在 Amplify Console → Environment variables 里设置
#
# 本地开发：cp .env.example .env，按 A 组填写即可（B 组本地不用填）。
# ─────────────────────────────────────────────────────────────────────────────


# ═════════════ A. 后端（EC2，经 S3 下发）═════════════

# 数据库：RDS MySQL 连接串（用户、密码、RDS endpoint、端口 3306、库名），
# 末尾加 ?connection_limit=10（见 app/lib/db.ts 的说明）
DATABASE_URL=

# 只在 EC2 上设为 true：启用 instrumentation.ts 里的 node-cron 定时任务
ENABLE_CRON=true

# OpenAI
OPENAI_API_KEY=

# 邮件（OTP / 找回密码）
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Stripe（webhook 地址换成 Amplify 域名后，signing secret 会变）
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# 内部密钥（cron 路由 / admin 路由）
CRON_SECRET=
ADMIN_SECRET=
CRISIS_ADMIN_USER_ID=

# 第三方服务
WEATHER_API_KEY=
ONESIGNAL_REST_API_KEY=

# 限流（middleware.ts）。只放后端，不要放进 Amplify，否则同一请求会被扣两次额度
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 文件存储：Cloudflare R2（app/lib/r2.ts）
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=


# ═════════════ B. 前端（Amplify Console 设置，不进 S3）═════════════

# EC2 的地址（Elastic IP），结尾不要带 /。next.config.ts 在 build 时读取，
# 把 /api/* 转发到这里；修改后必须在 Amplify 重新 build 才生效。
# BACKEND_URL=http://<EC2 Elastic IP>
